# 이 파일을 복사해 .env를 만들고 값을 채운다 (복사: copy .env.example .env)
# .env는 .gitignore에 들어 있다. 실제 키를 이 파일(.env.example)에 쓰지 않는다.

# OpenAI: LLM 답변 생성(저렴한·고성능 모델)과 클라우드 판단(Decisions)에 쓴다
OPENAI_API_KEY=

# xAI(Grok): 선택. 지금은 쓰지 않는다
XAI_API_KEY=

# 게이트웨이 키: 게이트웨이를 쓰는 서비스가 Authorization: Bearer <키>로 보낸다 (쉼표로 여러 개)
# 비워 두면 같은 PC(127.0.0.1)에서 온 요청만 받는다. 다른 PC나 역방향 프록시(nginx 등) 뒤에서 쓰려면 반드시 채운다.
# 프록시 뒤에서는 모든 요청이 같은 PC에서 온 것처럼 보이기 때문이다 (docs/decisions.md D20)
GATEWAY_API_KEYS=
